# Public site address. Used for canonical metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://chev.consulting

# Optional Google Analytics 4 measurement ID (for example, G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Razorpay. Use test keys (rzp_test_...) while building. The secret stays on the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Hostinger Mail API key from Emails → chevvanthi.in → Developers → Manage keys.
# EMAIL_USER is the mailbox address, for example hello@chevvanthi.in.
# BOOKING_NOTIFY_EMAIL is where new bookings arrive. Leave it blank to use that mailbox.
HOSTINGER_MAIL_API_TOKEN=
EMAIL_USER=
BOOKING_NOTIFY_EMAIL=

# Optional Firebase Web app configuration. Analytics initializes only when every value is set.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
